{
  "name": "omp-qq-bridge",
  "version": "4.1.0-beta.1",
  "private": true,
  "description": "项目本地的 QQ OneBot 11 与 omp RPC 桥接",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gulanthys/omp-qq-bridge.git"
  },
  "homepage": "https://github.com/gulanthys/omp-qq-bridge#readme",
  "bugs": {
    "url": "https://github.com/gulanthys/omp-qq-bridge/issues"
  },
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs"
  },
  "files": [
    "index.mjs",
    "launch.mjs",
    "lib/*.mjs",
    "lib/*.js",
    "tools/asr_cli.py",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "omp": {
    "extensions": [
      "./index.mjs"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs && node tests/inbound-batching.mjs && node tests/inbound-lifecycle.mjs && node tests/inbound-singleflight.mjs",
    "smoke": "node tests/smoke-omp.mjs memory-first && node tests/smoke-omp.mjs qq-first && node tests/smoke-omp.mjs standalone && node tests/smoke-omp.mjs replacement",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.4",
    "globals": "^17.14.0",
    "omp-echo-memory": "https://github.com/gulanthys/omp-echo-memory/releases/download/v1.1.0-beta.1/omp-echo-memory-1.1.0-beta.1.tgz",
    "prettier": "^3.9.10",
    "ws": "^8.22.1"
  }
}
